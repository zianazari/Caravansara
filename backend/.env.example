# Copy to backend/.env for local runs outside Docker. Every setting is in src/caravansara/core/config.py.
CARAVANSARA_DATABASE_URL=postgresql+asyncpg://caravansara:caravansara@localhost:5432/caravansara
CARAVANSARA_JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
CARAVANSARA_S3_ENDPOINT_URL=http://localhost:9000
CARAVANSARA_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
CARAVANSARA_MEDIA_BASE_URL=http://localhost:9000/caravansara-media
