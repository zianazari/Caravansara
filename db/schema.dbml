// Caravansara (Airbnb-like place reservation site) — paste into https://dbdiagram.io
// Mirrors db/schema.sql (updated 2026-11-13 through migration 0012; 17 application tables). EXCLUDE, triggers, partial/GiST indexes and
// DEFERRABLE can't be drawn in DBML; they are written in the notes.

Project caravansara {
  database_type: 'PostgreSQL'
  Note: 'Simple scope. Rank = star rating. Comments = review text only.'
}

Enum property_type {
  entire_place
  private_room
  shared_room
}

Enum booking_status {
  pending
  confirmed
  cancelled
  expired
  completed
}

Enum account_kind {
  member
  admin [note: 'only the create-admin command makes one']
}

Enum listing_review_status {
  pending
  approved
  rejected
}

Enum review_action {
  submitted
  edited [note: 'a descriptive edit sent an approved listing back to the queue']
  resubmitted
  approved
  rejected
}

TableGroup people_and_places [color: #1F6FEB] {
  users
  refresh_tokens
  auth_attempts
  countries
  cities
  listings
}

TableGroup listing_details [color: #8250DF] {
  listing_photos
  amenity_categories
  amenities
  listing_amenities
}

TableGroup booking_and_reviews [color: #D9822B] {
  bookings
  reviews
}

TableGroup listing_review [color: #1A7F37] {
  listing_review_events
  admin_address_views
}

Table users [headercolor: #1F6FEB] {
  id bigint [pk, increment]
  email text [not null]
  password_hash text [not null, note: 'argon2']
  full_name text [not null]
  avatar_url text
  created_at timestamptz [not null, default: `now()`]
  kind account_kind [not null, default: 'member', note: 'admins share this table so one email is one account of either kind; no API input has this field']
  disabled_at timestamptz [note: 'set by disable-admin; the admin stops working at once']

  indexes {
    `lower(email)` [unique, name: 'users_email_lower_key', note: 'A@x.com and a@x.com are one account']
    `(lower(email) || ' ' || lower(full_name))` [type: gin, name: 'users_search_trgm_idx', note: 'pg_trgm; the admin user search, any part of an email or a name (051)']
  }

  Note: 'Guests and hosts (members), and admins. A host is a member who owns listings. An admin token works on no member endpoint.'
}

Table refresh_tokens [headercolor: #1F6FEB] {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  token_hash text [not null, unique, note: 'only a hash is stored']
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  revoked_at timestamptz [note: 'set on logout or rotation']

  indexes {
    user_id [note: 'partial: WHERE revoked_at IS NULL']
  }
}

Table auth_attempts [headercolor: #1F6FEB] {
  id bigint [pk, increment]
  action text [not null, note: 'login | register | admin_login (admin logins count apart)']
  identifier text [not null, note: 'lower(email) or client IP']
  succeeded boolean [not null]
  attempted_at timestamptz [not null, default: `now()`]

  indexes {
    (action, identifier, attempted_at)
  }

  Note: 'Rate limit for login and registration: one row per attempt.'
}

Table countries [headercolor: #1F6FEB] {
  id smallint [pk, increment]
  code char(2) [not null, unique, note: 'ISO 3166-1, e.g. FI']
  name text [not null, unique]
}

Table cities [headercolor: #1F6FEB] {
  id int [pk, increment]
  country_id smallint [not null, ref: > countries.id]
  name text [not null]
  timezone text [not null, note: "IANA, e.g. Europe/Helsinki: 'today' and stay end use city time"]

  indexes {
    (country_id, name) [unique]
  }
}

Table listings [headercolor: #1F6FEB] {
  id bigint [pk, increment]
  host_id bigint [not null, ref: > users.id]
  title text [not null]
  description text
  property_type property_type [not null]
  city_id int [not null, ref: > cities.id]
  neighborhood text [note: 'e.g. Pasila']
  address text [not null, note: 'host and confirmed/completed guests only']
  latitude "numeric(9,6)" [not null, note: 'real point: private']
  longitude "numeric(9,6)" [not null, note: 'real point: private']
  public_location geography [not null, note: 'geography(Point, 4326): real point moved ~100-500 m, stored once; used for search, distance and pin']
  max_guests smallint [not null, note: 'adults + children; infants not counted']
  pets_allowed boolean [not null, default: false]
  max_pets smallint [not null, default: 0]
  bedrooms smallint [not null, default: 0]
  beds smallint [not null, default: 1]
  bathrooms "numeric(3,1)" [not null, default: 1]
  price_per_night "numeric(14,2)" [not null]
  cleaning_fee "numeric(14,2)" [not null, default: 0]
  currency char(3) [not null, default: 'EUR']
  pricing_policy jsonb [not null, default: `'{}'::jsonb`, note: 'Host policy: custom dates, shared holidays, weekend, base; percentages do not stack.']
  check_in_time time [not null, default: '15:00']
  check_out_time time [not null, default: '11:00']
  avg_rating "numeric(3,2)" [note: 'rank, cached by trigger on reviews']
  review_count int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  review_status listing_review_status [not null, default: 'pending', note: 'public = is_active AND approved; new listings wait for an admin']
  submitted_at timestamptz [default: `now()`, note: 'entered the review queue; required while pending']
  rejection_reason text [note: 'only while rejected, 1-1000 characters; the host reads it']
  review_version int [not null, default: 0, note: '+1 on every descriptive edit; a decision applies only to the version the admin saw']

  indexes {
    city_id
    host_id
    public_location [note: 'GiST, partial: WHERE is_active (radial search)']
    (submitted_at, id) [name: 'listings_review_queue_idx', note: 'partial: WHERE review_status = pending (the admin queue)']
  }
}

Table listing_photos [headercolor: #8250DF] {
  id bigint [pk, increment]
  listing_id bigint [not null, ref: > listings.id]
  storage_key text [not null, unique, note: 'object-storage key, e.g. listings/42/7f3a.jpg; app builds the CDN URL']
  width int [not null, note: 'px of the original']
  height int [not null, note: 'px of the original']
  caption text
  room_tag text [note: 'Kitchen, Bedroom 1 …']
  sort_order smallint [not null, note: '0 = cover photo']

  indexes {
    (listing_id, sort_order) [unique, note: 'DEFERRABLE INITIALLY DEFERRED: reorder in one transaction']
  }
}

Table amenity_categories [headercolor: #8250DF] {
  id smallint [pk, increment]
  name text [not null, unique, note: 'Kitchen and dining']
  sort_order smallint [not null, default: 0]
}

Table amenities [headercolor: #8250DF] {
  id smallint [pk, increment]
  category_id smallint [not null, ref: > amenity_categories.id]
  name text [not null, unique, note: 'Wifi, Microwave …']
  icon text
}

Table listing_amenities [headercolor: #8250DF] {
  listing_id bigint [not null, ref: > listings.id]
  amenity_id smallint [not null, ref: > amenities.id]

  indexes {
    (listing_id, amenity_id) [pk]
    amenity_id
  }
}

Table bookings [headercolor: #D9822B] {
  id bigint [pk, increment]
  listing_id bigint [not null, ref: > listings.id]
  guest_id bigint [not null, ref: > users.id]
  check_in date [not null]
  check_out date [not null]
  stay daterange [note: 'generated: [check_in, check_out)']
  adults smallint [not null, note: '>= 1']
  children smallint [not null, default: 0]
  infants smallint [not null, default: 0]
  pets smallint [not null, default: 0]
  nightly_price "numeric(14,2)" [not null, note: 'price snapshot']
  cleaning_fee "numeric(14,2)" [not null, default: 0]
  total_price "numeric(14,2)" [not null]
  nightly_prices jsonb [not null, default: `'[]'::jsonb`, note: 'Saved per-night price, source, percentage and label; never recalculated.']
  currency char(3) [not null]
  status booking_status [not null, default: 'pending']
  hold_expires_at timestamptz [note: 'pending hold while paying']
  paid_at timestamptz [note: 'when the guest paid; the receipt (047)']
  idempotency_key uuid [not null, unique]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    guest_id
    (id, listing_id, guest_id) [unique]
    hold_expires_at [note: "partial: WHERE status = 'pending' (worker)"]
    (listing_id, check_in, id) [note: "bookings of a listing, in page order"]
    stay [type: gist, note: "partial: WHERE status IN (pending, confirmed, completed); search with dates"]
    check_out [note: "partial: WHERE status = 'confirmed' (worker: complete stays)"]
    (status, id) [note: "admin bookings list: newest first, by status (051)"]
  }

  Note: '''
  NO DOUBLE BOOKING:
  EXCLUDE USING gist (listing_id WITH =, stay WITH &&)
  WHERE status IN (pending, confirmed, completed)
  '''
}

Table reviews [headercolor: #D9822B] {
  id bigint [pk, increment]
  booking_id bigint [not null, unique]
  listing_id bigint [not null]
  guest_id bigint [not null]
  rating smallint [not null, note: '1-5 stars']
  cleanliness_rating smallint
  accuracy_rating smallint
  check_in_rating smallint
  communication_rating smallint
  location_rating smallint
  value_rating smallint
  comment text [not null]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (listing_id, created_at)
  }

  Note: 'One review per completed booking (trigger). Composite FK ties listing and guest to the booking.'
}

Table listing_review_events [headercolor: #1A7F37] {
  id bigint [pk, increment]
  listing_id bigint [not null, ref: > listings.id]
  action review_action [not null]
  actor_id bigint [not null, ref: > users.id, note: 'the host (submitted, edited, resubmitted) or the admin (approved, rejected)']
  review_version int [not null, note: 'the version submitted or decided on']
  reason text [note: 'set exactly when action = rejected']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (listing_id, created_at)
  }

  Note: 'Append-only history of the review: a trigger refuses UPDATE and DELETE.'
}

Table admin_address_views [headercolor: #1A7F37] {
  id bigint [pk, increment]
  admin_id bigint [not null, ref: > users.id]
  listing_id bigint [not null, ref: > listings.id]
  viewed_at timestamptz [not null, default: `now()`]

  Note: 'One row each time an admin opens a listing with its exact address, in the same transaction (constitution V).'
}

// Composite FK: the review's listing and guest must be the booking's
Ref review_belongs_to_booking: reviews.(booking_id, listing_id, guest_id) > bookings.(id, listing_id, guest_id)

Table holidays [headercolor: #1F6FEB] {
  country_code char(2) [not null, ref: > countries.code]
  day date [not null]
  name text [not null, note: 'Trimmed length 1 to 100; managed by active admins.']
  indexes { (country_code, day) [pk] }
}

Table wishlist_items [headercolor: #D9822B] {
  user_id bigint [not null, ref: > users.id]
  listing_id bigint [not null, ref: > listings.id]
  saved_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, listing_id) [pk]
    (user_id, saved_at, listing_id) [note: 'saved_at DESC in PostgreSQL']
  }
  Note: 'Both foreign keys use ON DELETE CASCADE; at most 500 saves per member in the service.'
}

Table email_outbox [headercolor: #1A7F37] {
  id bigint [pk, increment]
  kind text [not null, note: 'listing_approved, listing_rejected, booking_confirmed_guest or booking_confirmed_host']
  user_id bigint [not null, ref: > users.id]
  subject text [not null]
  body text [not null]
  created_at timestamptz [not null, default: `now()`]
  next_attempt_at timestamptz [not null, default: `now()`]
  attempts smallint [not null, default: 0]
  sent_at timestamptz
  failed_at timestamptz
  last_error text
  Note: 'Transactional outbox; recipient FK cascades. Partial due index: next_attempt_at WHERE sent_at IS NULL AND failed_at IS NULL. Sent and failed cannot both be set.'
}
