erDiagram
    USERS ||--o{ LISTINGS : "hosts"
    USERS ||--o{ BOOKINGS : "books"
    USERS ||--o{ REFRESH_TOKENS : "signs in with"
    COUNTRIES ||--o{ CITIES : "has"
    CITIES ||--o{ LISTINGS : "located in"
    LISTINGS ||--o{ LISTING_PHOTOS : "has"
    LISTINGS ||--o{ LISTING_AMENITIES : "offers"
    AMENITIES ||--o{ LISTING_AMENITIES : "offered by"
    AMENITY_CATEGORIES ||--o{ AMENITIES : "groups"
    LISTINGS ||--o{ BOOKINGS : "reserved by"
    BOOKINGS ||--o| REVIEWS : "reviewed in"
    LISTINGS ||--o{ LISTING_REVIEW_EVENTS : "review history"
    USERS ||--o{ LISTING_REVIEW_EVENTS : "submits or decides"
    USERS ||--o{ ADMIN_ADDRESS_VIEWS : "admin opened"
    LISTINGS ||--o{ ADMIN_ADDRESS_VIEWS : "address seen"

    USERS {
        bigint id PK
        text email UK "unique on lower(email)"
        text password_hash
        text full_name
        text avatar_url
        timestamptz created_at
        account_kind kind "member | admin (create-admin only)"
        timestamptz disabled_at "disable-admin"
    }
    REFRESH_TOKENS {
        bigint id PK
        bigint user_id FK
        text token_hash UK
        timestamptz created_at
        timestamptz expires_at
        timestamptz revoked_at "logout or rotation"
    }
    AUTH_ATTEMPTS {
        bigint id PK
        text action "login | register | admin_login"
        text identifier "email or IP"
        boolean succeeded
        timestamptz attempted_at
    }
    COUNTRIES {
        smallint id PK
        char code UK "ISO, e.g. FI"
        text name UK
    }
    CITIES {
        int id PK
        smallint country_id FK
        text name "unique per country"
        text timezone "Europe/Helsinki"
    }
    LISTINGS {
        bigint id PK
        bigint host_id FK
        text title
        text description
        property_type property_type "entire_place | private_room | shared_room"
        int city_id FK
        text neighborhood "e.g. Pasila"
        text address "shown after booking"
        numeric latitude "real, private"
        numeric longitude "real, private"
        geography public_location "fuzzed pin, radial search"
        smallint max_guests "adults + children"
        boolean pets_allowed
        smallint max_pets
        smallint bedrooms
        smallint beds
        numeric bathrooms
        numeric price_per_night
        numeric cleaning_fee
        char currency
        time check_in_time
        time check_out_time
        numeric avg_rating "rank, cached"
        int review_count
        boolean is_active
        timestamptz created_at
        listing_review_status review_status "public = active and approved"
        timestamptz submitted_at "queue order"
        text rejection_reason "only while rejected"
        int review_version "+1 on each descriptive edit"
    }
    LISTING_REVIEW_EVENTS {
        bigint id PK
        bigint listing_id FK
        review_action action "append-only"
        bigint actor_id FK "host or admin"
        int review_version
        text reason "only for rejected"
        timestamptz created_at
    }
    ADMIN_ADDRESS_VIEWS {
        bigint id PK
        bigint admin_id FK
        bigint listing_id FK
        timestamptz viewed_at
    }
    LISTING_PHOTOS {
        bigint id PK
        bigint listing_id FK
        text storage_key UK "listings/42/7f3a.jpg"
        int width
        int height
        text caption
        text room_tag "Kitchen, Bedroom 1"
        smallint sort_order "0 = cover"
    }
    AMENITY_CATEGORIES {
        smallint id PK
        text name UK "Kitchen and dining"
        smallint sort_order
    }
    AMENITIES {
        smallint id PK
        smallint category_id FK
        text name UK "Wifi, Microwave"
        text icon
    }
    LISTING_AMENITIES {
        bigint listing_id PK, FK
        smallint amenity_id PK, FK
    }
    BOOKINGS {
        bigint id PK
        bigint listing_id FK
        bigint guest_id FK
        date check_in
        date check_out
        daterange stay "no overlap per listing"
        smallint adults
        smallint children
        smallint infants
        smallint pets
        numeric nightly_price "snapshot"
        numeric cleaning_fee
        numeric total_price
        char currency
        booking_status status "pending | confirmed | cancelled | expired | completed"
        timestamptz hold_expires_at
        uuid idempotency_key UK
        timestamptz created_at
    }
    REVIEWS {
        bigint id PK
        bigint booking_id FK, UK "one per completed booking"
        bigint listing_id FK
        bigint guest_id FK
        smallint rating "1-5 stars"
        smallint cleanliness_rating
        smallint accuracy_rating
        smallint check_in_rating
        smallint communication_rating
        smallint location_rating
        smallint value_rating
        text comment
        timestamptz created_at
    }
