# Copy to frontend/.env.local for `npm run dev`. Nothing here is a secret: NEXT_PUBLIC_* values are built into
# the browser code, so a secret must never be put in one.
# Where the API answers, read by the server only (the /api/v1 forwarder and server-rendered pages).
API_INTERNAL_URL=http://localhost:8000
# Origin of the photo storage; pictures load only from here (content security policy, FR-041).
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/caravansara-media
# Raster map tiles. OpenStreetMap for development; another provider in production (research R22).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Port of the site (3000 is Grafana's).
PORT=3001
