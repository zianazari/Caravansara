// Grafana Alloy: the one collector. It reads every container's log from Docker and sends
// it to Loki, and receives the app's OpenTelemetry traces and sends them to Tempo.

// ---- logs: Docker → Loki -------------------------------------------------------------

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "caravansara" {
  targets = []

  // only this compose project
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "caravansara"
    action        = "keep"
  }
  // service="api", "worker", "db", ...: few values, so a good label
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.caravansara.rules
  forward_to    = [loki.process.app.receiver]
}

// The API and the worker write JSON. The level becomes a label (few values); request and
// trace ids become structured metadata (one value per request, so never labels).
loki.process "app" {
  stage.match {
    selector = "{service=~\"api|worker|migrate\"}"

    stage.json {
      expressions = { level = "level", request_id = "request_id", trace_id = "trace_id" }
    }
    stage.labels {
      values = { level = "" }
    }
    stage.structured_metadata {
      values = { request_id = "", trace_id = "" }
    }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---- traces: OTLP → Tempo ------------------------------------------------------------

otelcol.receiver.otlp "app" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces = [otelcol.processor.batch.app.input]
  }
}

otelcol.processor.batch "app" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
